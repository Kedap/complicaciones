<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="ANALOG" />
    <Metadata key="PREVIEW_TIME" value="10:09:30" />

    <Scene backgroundColor="#ff000000">
        <!-- ponytail: bloque fijo arriba a la izquierda; usar Condition con
             cuatro anclas solo si el solapamiento con agujas resulta molesto. -->
        <Group name="terminal_block" x="68" y="104" width="180" height="112">
            <PartImage name="pixel_icons" x="0" y="0" width="54" height="104" alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Image resource="terminal_icons" />
            </PartImage>

            <PartText name="head" x="40" y="0" width="140" height="22" alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Text align="START" ellipsis="FALSE">
                    <Font family="silkscreen_regular" size="17" color="#ffFF6B00">
                        <Template>%s<Parameter expression="terminal_head" /></Template>
                    </Font>
                </Text>
            </PartText>

            <PartText name="date" x="60" y="22" width="120" height="22" alpha="255">
                <Localization locales="es-MX" />
                <Variant mode="AMBIENT" target="color" value="#ff7A7A74" />
                <Text align="START" ellipsis="FALSE">
                    <Font family="silkscreen_regular" size="16" color="#ffD9D7CE">
                        <Lower>
                            <Template>%s %d %s
                                <Parameter expression="[DAY_OF_WEEK_S]" />
                                <Parameter expression="[DAY]" />
                                <Parameter expression="[MONTH_S]" />
                            </Template>
                        </Lower>
                    </Font>
                </Text>
            </PartText>

            <PartText name="temperature" x="60" y="43" width="120" height="22" alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Text align="START" ellipsis="FALSE">
                    <Font family="silkscreen_regular" size="16" color="#ffD9D7CE">
                        <Template>%s<Parameter expression="terminal_temperature" /></Template>
                    </Font>
                </Text>
            </PartText>

            <PartText name="battery" x="60" y="64" width="120" height="22" alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Text align="START" ellipsis="FALSE">
                    <Font family="silkscreen_regular" size="16" color="#ffD9D7CE">
                        <Template>%d%%<Parameter expression="round([BATTERY_PERCENT])" /></Template>
                    </Font>
                </Text>
            </PartText>

            <PartText name="meeting" x="60" y="85" width="120" height="22" alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Text align="START" ellipsis="FALSE">
                    <Font family="silkscreen_regular" size="16" color="#ffFF6B00">
                        <Template>%s<Parameter expression="terminal_meeting" /></Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <PartDraw name="hour_hand" x="221" y="97" width="7" height="128"
                  pivotX="0.5" pivotY="1.0">
            <Transform target="angle" value="[HOUR_0_11_MINUTE] * 30" />
            <RoundRectangle x="0" y="0" width="7" height="128"
                            cornerRadiusX="3.5" cornerRadiusY="3.5">
                <Fill color="#ffEDE9DC" />
            </RoundRectangle>
        </PartDraw>

        <PartDraw name="minute_hand" x="221" y="19" width="7" height="206"
                  pivotX="0.5" pivotY="1.0">
            <Transform target="angle" value="[MINUTE_SECOND] * 6" />
            <RoundRectangle x="0" y="0" width="7" height="206"
                            cornerRadiusX="3.5" cornerRadiusY="3.5">
                <Fill color="#ffEDE9DC" />
            </RoundRectangle>
        </PartDraw>

        <PartDraw name="pivot" x="213" y="213" width="24" height="24" alpha="255">
            <RoundRectangle x="0" y="0" width="24" height="24"
                            cornerRadiusX="9" cornerRadiusY="9">
                <Fill color="#ffEDE9DC" />
            </RoundRectangle>
        </PartDraw>

        <PartDraw name="cursor_tail_far" x="219" y="8" width="12" height="217"
                  pivotX="0.5" pivotY="1.0" alpha="76">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="angle" value="[SECOND] * 6 - 7" />
            <RoundRectangle x="3.5" y="3.5" width="5" height="5"
                            cornerRadiusX="1" cornerRadiusY="1">
                <Fill color="#ffFF6B00" />
            </RoundRectangle>
        </PartDraw>

        <PartDraw name="cursor_tail_mid" x="219" y="8" width="12" height="217"
                  pivotX="0.5" pivotY="1.0" alpha="140">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="angle" value="[SECOND] * 6 - 4.5" />
            <RoundRectangle x="2.5" y="2.5" width="7" height="7"
                            cornerRadiusX="1" cornerRadiusY="1">
                <Fill color="#ffFF6B00" />
            </RoundRectangle>
        </PartDraw>

        <PartDraw name="cursor_tail_near" x="219" y="8" width="12" height="217"
                  pivotX="0.5" pivotY="1.0" alpha="204">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="angle" value="[SECOND] * 6 - 2" />
            <RoundRectangle x="1.5" y="1.5" width="9" height="9"
                            cornerRadiusX="1" cornerRadiusY="1">
                <Fill color="#ffFF6B00" />
            </RoundRectangle>
        </PartDraw>

        <PartDraw name="cursor" x="219" y="8" width="12" height="217"
                  pivotX="0.5" pivotY="1.0" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Transform target="angle" value="[SECOND] * 6" />
            <RoundRectangle x="0" y="0" width="12" height="12"
                            cornerRadiusX="1" cornerRadiusY="1">
                <Fill color="#ffFF6B00" />
            </RoundRectangle>
        </PartDraw>
    </Scene>
</WatchFace>
